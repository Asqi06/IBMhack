# --- IBM watsonx.ai (Granite) ---
# Paste values from your IBM Cloud account. Do NOT commit real keys.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Region URL: e.g. https://us-south.ml.cloud.ibm.com or https://eu-de.ml.cloud.ibm.com or https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Model tuned in Prompt Lab; default is granite-3-8b-instruct. Use exact string from your account.
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
# IAM endpoint (usually unchanged)
WATSONX_IAM_URL=https://iam.cloud.ibm.com/identity/token
# When true, agents return deterministic mock results without calling IBM (for local dev without keys)
MOCK_GRANITE=false

# --- Google Safe Browsing ---
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Blockchain ledger ---
# fabric = call real Hyperledger Fabric gateway; fallback = local hash-chained SQLite log
LEDGER_MODE=fallback
# Only needed when LEDGER_MODE=fabric
FABRIC_GATEWAY_URL=http://localhost:3000
# Where fallback SQLite file lives (relative to backend/)
FALLBACK_DB_PATH=./ledger.db

# --- Server ---
PORT=8000
# CORS: comma-separated origins, or * for dev
CORS_ORIGINS=*

# Never ship secrets or local state into the image.
# The Dockerfile does `COPY . .`, so anything not listed here lands in a layer
# that survives `docker history` even if a later layer deletes it.
.env
.env.*
!.env.example
*.db
*.db-journal
*.db-wal
*.db-shm

# Local Python cruft
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# VCS + docs + local helper scripts (not needed at runtime)
.git/
.gitignore
*.md
run.ps1
render.yaml
deploy-codeengine.sh
